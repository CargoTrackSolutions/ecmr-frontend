# Runtime configuration of the ecmr-frontend image (rendered into assets/deployment/env.js and the nginx CSP at startup).

# eCMR backend API (ecmr-backend, path /api)
BACKEND_API_URL=https://ecmr-api.example.cargotrack.ro/api

# OIDC identity provider - same issuer as the backend's SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUERURI.
# Public client with Authorization Code + PKCE; valid redirect URI: https://<frontend-host>/login-callback
OAUTH_ISSUER=https://login.example.cargotrack.ro/realms/cargotrack
OAUTH_CLIENT_ID=ecmr-frontend
OAUTH_ADDITIONAL_SCOPES=

# Who may embed the app in an iframe (CSP frame-ancestors). Default: 'self' https://*.cargotrack.ro
# FRAME_ANCESTORS='self' https://*.cargotrack.ro

# Origins the app may call (CSP connect-src). Default: origins of BACKEND_API_URL and OAUTH_ISSUER
# CSP_CONNECT_SRC=https://ecmr-api.example.cargotrack.ro https://login.example.cargotrack.ro

# Theme colours (defaults baked into the image = CargoTrack/TMS palette)
# PRIMARY_COLOR=#2063F3
# SECONDARY_COLOR=#00C6DB
# TERTIARY_COLOR=#49677D
# ERROR_COLOR=#F32020
